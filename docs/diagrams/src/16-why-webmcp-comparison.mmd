    direction TB
    
    subgraph T1["1. Server-Side MCP"]
      A["To search files, the server must hold them.<br/>Uploading violates confidentiality.<br/><b>The server has already read what it pretends not to know.</b>"]
    end

    subgraph T2["2. REST API Backend"]
      B["No shared visual surface.<br/>Human cannot watch or approve in flow.<br/><b>Per-page approval requires looking at the same live page.</b>"]
    end

    subgraph T3["3. Computer-Use / Playwright"]
      C["Cannot join user's active session.<br/>Must screenshot screen to read text.<br/><b>Plaintext leaks through screenshots into the LLM.</b>"]
    end

    subgraph T4["4. Extension / OS Agent"]
      D["Reads entire tab DOM or filesystem.<br/><b>No structured contract to allow metadata while sealing text.</b>"]
    end
  end

  subgraph T5["★ Browser-Native WebMCP"]
    E1["execute() runs INSIDE the user's tab holding the plaintext."]
    E2["Local BM25 index returns 0 text; Selective Gate releases snippets."]
    E3["<b>Search and disclosure are separate capabilities. Real human-in-the-loop control.</b>"]
    E1 --> E2 --> E3
  end

